{
  "name": "init_scheme_full",
  "results_dir": "experiments/results/init_scheme_full",
  "seeds": [1, 2, 3],
  "metric": "test_macro_auroc",
  "baseline": "xavier_uniform (repo default)",
  "base": {
    "data": "./data",
    "split": "complex_disease",
    "split_seed": 42,
    "device": null,
    "model": {
      "n_hid": 100,
      "n_inp": 100,
      "n_out": 100,
      "proto": true,
      "proto_num": 3,
      "attention": false,
      "sim_measure": "all_nodes_profile",
      "agg_measure": "rarity",
      "num_walks": 200,
      "path_length": 2,
      "init_scheme": null
    },
    "pretrain": {
      "n_epoch": 2,
      "learning_rate": 0.001,
      "batch_size": 1024,
      "train_print_per_n": 200
    },
    "finetune": {
      "n_epoch": 500,
      "learning_rate": 0.0005,
      "train_print_per_n": 100,
      "valid_per_n": 20
    }
  },
  "variants": [
    {
      "name": "xavier_uniform (repo default)",
      "overrides": {"model.init_scheme": null}
    },
    {
      "name": "kaiming_uniform (leaky_relu)",
      "overrides": {
        "model.init_scheme": {"name": "kaiming_uniform", "nonlinearity": "leaky_relu"}
      }
    },
    {
      "name": "kaiming_normal (leaky_relu)",
      "overrides": {
        "model.init_scheme": {"name": "kaiming_normal", "nonlinearity": "leaky_relu"}
      }
    },
    {
      "name": "orthogonal",
      "overrides": {"model.init_scheme": {"name": "orthogonal", "gain": "relu"}}
    },
    {
      "name": "kaiming layers only",
      "overrides": {"model.init_scheme": {"layer": "kaiming_uniform"}}
    }
  ]
}
